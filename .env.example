# Copy to .env and fill in. .env is gitignored.
# This build uses Claude Code CLI (your subscription) — no API key needed.

# Firecrawl base URL — point at a self-hosted Firecrawl instance or fire.firecrawl.dev
# Self-host: https://github.com/mendableai/firecrawl
FIRECRAWL_URL=http://firecrawl:3002
# Optional Firecrawl API key if your instance requires it
FIRECRAWL_API_KEY=

# Where SQLite + backups live (inside the container; bind-mounted from host)
DATA_DIR=/app/data

# Port the app listens on inside the container
APP_PORT=8556

# Set to "1" to enable LLM model discovery on refresh
ENABLE_DISCOVERY=1

# Nightly auto-refresh schedule (UTC). Set ENABLE_NIGHTLY=0 to disable.
ENABLE_NIGHTLY=1
NIGHTLY_HOUR_UTC=3
NIGHTLY_MINUTE_UTC=0

# Path to the claude CLI inside the container (override only if you customised the image)
CLAUDE_BIN=claude
